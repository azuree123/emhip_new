# Copy to .env and fill in real values before running `docker compose up`.

# SQL Server requires 8+ characters including at least 3 of: uppercase, lowercase, digit, symbol.
MSSQL_SA_PASSWORD=Ch4ngeMe!2026

# Signs the JWTs issued at login. Use a long random string (32+ chars) — e.g. `openssl rand -base64 48`.
JWT_KEY=REPLACE_WITH_A_REAL_RANDOM_SECRET_AT_LEAST_32_CHARS

# Shared secret between Emhip.Workers and Emhip.Api for the internal urgent-case notification call.
INTERNAL_SHARED_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET

# First Admin account, created automatically on first boot if no users exist yet (see IdentitySeeder).
# Change the password after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@emhip.local
BOOTSTRAP_ADMIN_PASSWORD=Ch4ngeMe!2026

# --- Production only (docker-compose.prod.yml) ---

# Public origin the app is served from — used for CORS and links generated by the API.
#PUBLIC_ORIGIN=http://81.0.221.206

# SQL Server edition. Production default is Express (free, licensed for prod, 10GB/db).
# Set to Developer only for non-production, or to a paid edition/license key.
#MSSQL_PID=Express
